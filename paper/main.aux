\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {When does cheap selection matter?} Score vs.\ measured per-slide wall-clock (log scale). Green: foundation model on $K$, $4K$, $16K$ random tiles (trained on random tiles). Lines for the selectors go from selective inference to escalating the least confident 10\% and 20\% of slides to the full-slide model. On focal metastasis tasks (left) random tiles fail and selection is required; on diffuse subtyping tasks (right) a few random tiles match every selector at a quarter of the cost. CAMELYON16 tiling time was not measured, so its random-tile cost is a lower bound.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:frontier}{{3}{4}{\textbf {When does cheap selection matter?} Score vs.\ measured per-slide wall-clock (log scale). Green: foundation model on $K$, $4K$, $16K$ random tiles (trained on random tiles). Lines for the selectors go from selective inference to escalating the least confident 10\% and 20\% of slides to the full-slide model. On focal metastasis tasks (left) random tiles fail and selection is required; on diffuse subtyping tasks (right) a few random tiles match every selector at a quarter of the cost. CAMELYON16 tiling time was not measured, so its random-tile cost is a lower bound}{figure.caption.5}{}}
